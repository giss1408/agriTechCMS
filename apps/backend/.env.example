# Copy to .env. Every variable is prefixed AGT_.
AGT_ENV=dev
AGT_DATABASE_URL=sqlite+aiosqlite:///./agritech.db
# AGT_DATABASE_URL=postgresql+asyncpg://agritech:agritech@localhost:5432/agritech
AGT_AUTO_CREATE_SCHEMA=true
AGT_SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
AGT_OTP_ECHO=true
AGT_PAYMENT_PROVIDER=sandbox
AGT_PAYMENT_WEBHOOK_SECRET=change-me
AGT_USSD_KEY=change-me
AGT_PUBLIC_WEB_URL=http://localhost:5173
